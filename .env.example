# IncidentPilot Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# Cloudflare Account Configuration
# Required for deployment
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=debug
APPROVAL_TIMEOUT_SECONDS=300

# Authentication (optional - set to enable auth)
# AUTH_SECRET=your_secret_key_here

# Notes:
# - Workers AI, R2, Vectorize, Durable Objects, and Workflows
#   are configured via wrangler.jsonc bindings, not env vars.
# - No API keys for OpenAI/Anthropic required.
# - All AI inference runs on Cloudflare Workers AI.
